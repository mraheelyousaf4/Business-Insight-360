// ============================================================
// Key measures
// Business Insight 360 | Power BI
// All measures live in the 'Key Measures' table.
// Display helpers (titles, labels, colours) are in ui_measures.dax.
// ============================================================


// ------------------------------------------------------------
// 1. Sales and deductions
// ------------------------------------------------------------

GS $ = SUM ( fact_actuals_estimates[gross_sales_amount] )

NIS $ = SUM ( fact_actuals_estimates[net_invoice_sales_amount] )

Pre Invoice Deduction $ = [GS $] - [NIS $]

Post Invoice Deduction $ = SUM ( fact_actuals_estimates[post_invoice_deductions_amount] )

Post Invoice other Deduction $ = SUM ( fact_actuals_estimates[post_invoice_other_deductions_amount] )

Total Post Invoice Deduction $ = [Post Invoice Deduction $] + [Post Invoice other Deduction $]

NS $ = SUM ( fact_actuals_estimates[net_sales_amount] )

Quantity = SUM ( fact_actuals_estimates[Qty] )


// ------------------------------------------------------------
// 2. Costs, gross margin and net profit
// ------------------------------------------------------------

Manufacturing Cost $ = SUM ( fact_actuals_estimates[manufacturing_cost] )

Freight Cost $ = SUM ( fact_actuals_estimates[freight_cost] )

Other Cost $ = SUM ( fact_actuals_estimates[other_cost] )

Total COGS $ = [Manufacturing Cost $] + [Freight Cost $] + [Other Cost $]

GM $ = [NS $] - [Total COGS $]

GM % = DIVIDE ( [GM $], [NS $], 0 )

GM / Unit = DIVIDE ( [GM $], [Quantity], 0 )

Ads & Promotions $ = SUM ( fact_actuals_estimates[ads_promotions] )

Other Operational Expense $ = SUM ( fact_actuals_estimates[other_operational_expense] )

// Shown as a negative number so it reads as a cost in the P&L
Operational Expense $ = ( [Ads & Promotions $] + [Other Operational Expense $] ) * -1

Net Profit $ = [GM $] + [Operational Expense $]

Net Profit % = DIVIDE ( [Net Profit $], [NS $], 0 )


// ------------------------------------------------------------
// 3. Last year and targets
// ------------------------------------------------------------

NS $ LY = CALCULATE ( [NS $], SAMEPERIODLASTYEAR ( dim_date[date] ) )

GM % LY = CALCULATE ( [GM %], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Net Profit % LY = CALCULATE ( [Net Profit %], SAMEPERIODLASTYEAR ( dim_date[date] ) )

// Targets are set by market, so hide them when a customer or product is selected
NS Target $ =
VAR tgt = SUM ( NsGmTarget[ns_target] )
RETURN
    IF ( [Customer / Product Filter Check], BLANK (), tgt )

GM Target $ = SUM ( NsGmTarget[gm_target] )

NP Target $ = SUM ( NsGmTarget[np_target] )

GM % Target = DIVIDE ( [GM Target $], SUM ( NsGmTarget[ns_target] ), 0 )

NP % Target = DIVIDE ( [NP Target $], SUM ( NsGmTarget[ns_target] ), 0 )

Customer / Product Filter Check =
ISCROSSFILTERED ( dim_product[product] ) || ISFILTERED ( dim_customer[customer] )


// ------------------------------------------------------------
// 4. Benchmark switch (vs LY or vs Target)
// 'Set BM'[ID]: 1 = last year, 2 = target
// ------------------------------------------------------------

NS BM $ =
SWITCH (
    TRUE (),
    SELECTEDVALUE ( 'Set BM'[ID] ) = 1, [NS $ LY],
    SELECTEDVALUE ( 'Set BM'[ID] ) = 2, [NS Target $]
)

GM % BM =
SWITCH (
    TRUE (),
    SELECTEDVALUE ( 'Set BM'[ID] ) = 1, [GM % LY],
    SELECTEDVALUE ( 'Set BM'[ID] ) = 2, [GM % Target]
)

NP % BM =
SWITCH (
    TRUE (),
    SELECTEDVALUE ( 'Set BM'[ID] ) = 1, [Net Profit % LY],
    SELECTEDVALUE ( 'Set BM'[ID] ) = 2, [NP % Target]
)

Δ NS $ = IF ( [NS BM $] = BLANK (), BLANK (), DIVIDE ( [NS $], [NS BM $], 0 ) - 1 )

Δ GM % = IF ( [GM % BM] = BLANK (), BLANK (), DIVIDE ( [GM %], [GM % BM], 0 ) - 1 )

Δ NP % = IF ( [NP % BM] = BLANK (), BLANK (), DIVIDE ( [Net Profit %], [NP % BM], 0 ) - 1 )

GM % Variance = [GM % BM] - [GM %]

// Used by the Gross Margin % variance slider on the Sales page
GM % Filter =
IF ( [GM % Variance] >= SELECTEDVALUE ( 'Target Gap Tolerance'[Target Gap Tolerance] ), 1, 0 )


// ------------------------------------------------------------
// 5. P&L statement
// One measure returns the right value for each P&L row,
// based on the row's order in the 'P & L Rows' table.
// ------------------------------------------------------------

P & L values =
VAR res =
    SWITCH (
        TRUE (),
        MAX ( 'P & L Rows'[Order] ) = 1, [GS $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 2, [Pre Invoice Deduction $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 3, [NIS $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 4, [Post Invoice Deduction $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 5, [Post Invoice other Deduction $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 6, [Post Invoice Deduction $] / 1000000 + [Post Invoice other Deduction $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 7, [NS $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 8, [Manufacturing Cost $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 9, [Freight Cost $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 10, [Other Cost $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 11, [Total COGS $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 12, [GM $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 13, [GM %] * 100,
        MAX ( 'P & L Rows'[Order] ) = 14, [GM / Unit],
        MAX ( 'P & L Rows'[Order] ) = 15, [Operational Expense $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 16, [Net Profit $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 17, [Net Profit %] * 100
    )
RETURN
    IF ( HASONEVALUE ( 'P & L Rows'[Description] ), res, [NS $] / 1000000 )

P & L LY = CALCULATE ( [P & L values], SAMEPERIODLASTYEAR ( dim_date[date] ) )

// Targets exist only for Net Sales, Gross Margin and Net Profit rows
P & L Target =
VAR res =
    SWITCH (
        TRUE (),
        MAX ( 'P & L Rows'[Order] ) = 7, [NS Target $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 12, [GM Target $] / 1000000,
        MAX ( 'P & L Rows'[Order] ) = 13, [GM % Target] * 100,
        MAX ( 'P & L Rows'[Order] ) = 17, [NP % Target] * 100
    )
RETURN
    IF ( HASONEVALUE ( 'P & L Rows'[Description] ), res, [NS Target $] / 1000000 )

P & L BM =
SWITCH (
    TRUE (),
    SELECTEDVALUE ( 'Set BM'[ID] ) = 1, [P & L LY],
    SELECTEDVALUE ( 'Set BM'[ID] ) = 2, [P & L Target]
)

P & L Chg =
VAR res = [P & L values] - [P & L BM]
RETURN
    IF ( ISBLANK ( [P & L BM] ) || ISBLANK ( [P & L values] ), BLANK (), res )

P & L Chg % =
VAR res = DIVIDE ( [P & L Chg], [P & L BM], 0 ) * 100
RETURN
    IF ( ISBLANK ( [P & L BM] ) || ISBLANK ( [P & L values] ), BLANK (), res )

// Picks the value for each P&L column: selected year, BM, Chg or Chg %
P & L Final Value =
SWITCH (
    TRUE (),
    SELECTEDVALUE ( fiscal_year[fy_desc] ) = MAX ( 'P & L Columns'[Col Header] ), [P & L values],
    MAX ( 'P & L Columns'[Col Header] ) = "BM", [P & L BM],
    MAX ( 'P & L Columns'[Col Header] ) = "Chg", [P & L Chg],
    MAX ( 'P & L Columns'[Col Header] ) = "Chg %", [P & L Chg %]
)


// ------------------------------------------------------------
// 6. Supply chain: forecast accuracy
// Only months up to the last actual sales month are compared.
// ------------------------------------------------------------

Sales Qty =
CALCULATE (
    SUM ( fact_actuals_estimates[Qty] ),
    fact_actuals_estimates[date] <= MAX ( LastSalesMonth[LastSalesMonth] )
)

Forecast Qty =
VAR lsalesdate = MAX ( LastSalesMonth[LastSalesMonth] )
RETURN
    CALCULATE ( SUM ( fact_forecast_monthly[forecast_quantity] ), fact_forecast_monthly[date] <= lsalesdate )

// Positive = forecast was too high (excess inventory)
// Negative = forecast was too low (out of stock risk)
Net Error = [Forecast Qty] - [Sales Qty]

Net Error % = DIVIDE ( [Net Error], [Forecast Qty], 0 )

// Absolute error is summed at month and product level so that
// over- and under-forecasts do not cancel each other out
ABS Error =
SUMX (
    DISTINCT ( dim_date[month] ),
    SUMX ( DISTINCT ( dim_product[product_code] ), ABS ( [Net Error] ) )
)

ABS Error % = DIVIDE ( [ABS Error], [Forecast Qty], 0 )

Forecast Accuracy % = IF ( [ABS Error %] <> BLANK (), 1 - [ABS Error %], BLANK () )

Forecast Accuracy % LY = CALCULATE ( [Forecast Accuracy %], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Net Error LY = CALCULATE ( [Net Error], SAMEPERIODLASTYEAR ( dim_date[date] ) )

ABS Error LY = CALCULATE ( [ABS Error], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Forecast Accuracy Variance = [Forecast Accuracy %] - [Forecast Accuracy % LY]

Net Error Variance = [Net Error] - [Net Error LY]

Δ FCA % = IF ( [Forecast Accuracy % LY] = BLANK (), BLANK (), DIVIDE ( [Forecast Accuracy %], [Forecast Accuracy % LY], 0 ) - 1 )

Δ ABS Error = IF ( [ABS Error LY] = BLANK (), BLANK (), DIVIDE ( [ABS Error], [ABS Error LY], 0 ) - 1 )

Δ Net Error = IF ( [Net Error LY] = BLANK (), BLANK (), DIVIDE ( [Net Error], [Net Error LY], 0 ) - 1 )

// EI = excess inventory, OOS = out of stock
Risk = IF ( [Net Error] > 0, "EI", IF ( [Net Error] < 0, "OOS", BLANK () ) )


// ------------------------------------------------------------
// 7. Executive: revenue contribution and market share
// ------------------------------------------------------------

// Share of total net sales, ignoring market, customer and product filters
RC % =
DIVIDE (
    [NS $],
    CALCULATE ( [NS $], ALL ( dim_market ), ALL ( dim_customer ), ALL ( dim_product ) )
)

Market Share % = DIVIDE ( SUM ( marketshare[sales_$] ), SUM ( marketshare[total_market_sales_$] ), 0 )

AtliQ MS % = CALCULATE ( [Market Share %], marketshare[manufacturer] = "atliq" )

AtliQ MS % LY =
CALCULATE (
    [AtliQ MS %],
    TREATAS ( VALUES ( fiscal_year[prior_fiscal_year] ), fiscal_year[fiscal_year] )
)

Δ MS % = IF ( [AtliQ MS % LY] = BLANK (), BLANK (), DIVIDE ( [AtliQ MS %], [AtliQ MS % LY], 0 ) - 1 )

// Flags the top 5 customers or products by net sales,
// depending on the Product / Customer toggle
Top N Flag Exec =
VAR SelectedField = SELECTEDVALUE ( 'Param Executive Product vs Customer'[Parameter Order] )
VAR CurrentRank =
    SWITCH (
        SelectedField,
        1, RANKX ( ALLSELECTED ( dim_customer[customer] ), [NS $],, DESC, DENSE ),
        0, RANKX ( ALLSELECTED ( dim_product[product] ), [NS $],, DESC, DENSE )
    )
RETURN
    IF ( CurrentRank <= 5, 1 )
